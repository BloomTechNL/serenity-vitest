{
  "name": "@bloom-group/serenity-vitest",
  "version": "0.1.0",
  "description": "Serenity/JS test runner adapter for Vitest: Screenplay Pattern support and Serenity/JS reporting (Serenity BDD, console reporter, ...) for Vitest test suites",
  "keywords": [
    "serenity-js",
    "serenity",
    "screenplay",
    "vitest",
    "reporter",
    "bdd",
    "living-documentation"
  ],
  "author": "Bloom Group",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BloomTechNL/serenity-vitest.git"
  },
  "homepage": "https://github.com/BloomTechNL/serenity-vitest#readme",
  "bugs": {
    "url": "https://github.com/BloomTechNL/serenity-vitest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run clean && npm test"
  },
  "peerDependencies": {
    "@serenity-js/core": "^3.45.0",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@serenity-js/assertions": "^3.49.1",
    "@serenity-js/console-reporter": "^3.49.1",
    "@serenity-js/core": "^3.49.1",
    "@serenity-js/serenity-bdd": "^3.49.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
